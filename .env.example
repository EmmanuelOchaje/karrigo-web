# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must never hold a real value.

# The hostname the ops panel answers on. Everything else serves the customer
# site, and /admin 404s there. It has to match the domain exactly — point it
# at a host the deployment does not serve and ops silently shows the customer
# site instead. See "Two domains, one deployment" in CLAUDE.md.
#
#   production   admin.karrigo.app
#   vercel       karrigo-admin.vercel.app
#
# Development needs no value: admin.localhost:3000 is always treated as the
# ops host.
ADMIN_HOST=

# The one ops account, until real auth lands in M3. Compared in plain text —
# fine for one account on one machine, not something to ship.
OPS_ADMIN_EMAIL=
OPS_ADMIN_PASSWORD=
