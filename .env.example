# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# and must never hold a real value.

# The hostname the ops panel answers on. Everything else serves the customer
# site, and /admin 404s there. It has to match the domain exactly — point it
# at a host the deployment does not serve and ops silently shows the customer
# site instead. See "Two domains, one deployment" in CLAUDE.md.
#
#   production   admin.karrigo.app
#   vercel       karrigo-admin.vercel.app
#
# Development needs no value: admin.localhost:3000 is always treated as the
# ops host.
ADMIN_HOST=

# The karrigo-be API, including the /v1 prefix. Both the ops panel and the
# ordering flow talk to it from the server — browsers never call it directly.
# Defaults to the production backend if unset, so point a local or staging
# deployment at its own backend here rather than testing against live data.
#
#   production   https://rx.karrigo.app/v1
#   local        http://localhost:3000/v1   (run karrigo-be on another port
#                than this app, which also defaults to 3000)
KARRIGO_API_URL=

# The host emailed app links use (go.karrigo.app). It must point at this same
# deployment. In development go.localhost:3000 is always treated as the link host.
# Tapping a link opens the Karrigo app if installed (iOS universal links,
# Android App Links), otherwise the page under app/go.
LINK_HOST=

# Verification files served at /.well-known/ so the phones trust the link host.
# Until set, the files 404 and links open in the browser instead of the app.
#   APPLE_TEAM_ID           10-character Team ID, Apple Developer account
#   ANDROID_SHA256_*        release-signing SHA-256 fingerprint(s), comma-separated
#                           (eas credentials -p android, or Play Console > App signing)
APPLE_TEAM_ID=
ANDROID_SHA256_PARTNER=
ANDROID_SHA256_EATS=

# Store listings shown to people who tap a link without the app. Leave blank
# until the apps are published; the page then says the app is coming soon.
PARTNER_IOS_STORE_URL=
PARTNER_ANDROID_STORE_URL=
EATS_IOS_STORE_URL=
EATS_ANDROID_STORE_URL=
